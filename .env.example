# Скопируйте этот файл в .env и заполните значения. Файл .env в git не попадает.
# Для разработки на своём компьютере .env не нужен: всё работает со значениями по умолчанию.

# Режим работы: 0 на сервере, 1 для разработки
DJANGO_DEBUG=0

# Секретный ключ. Сгенерировать:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=вставьте-сюда-длинную-случайную-строку

# Адрес сайта (через запятую, без пробелов)
DJANGO_ALLOWED_HOSTS=example.ru,www.example.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.ru,https://www.example.ru

# Если у сайта пока нет HTTPS, поставьте 0. Когда HTTPS настроен, можно включить HSTS (в секундах).
DJANGO_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=0

# PostgreSQL. Если DB_NAME не задан, используется SQLite (файл db.sqlite3).
DB_NAME=classquiz
DB_USER=classquiz
DB_PASSWORD=придумайте-пароль
DB_HOST=localhost
DB_PORT=5432

# Почта (необязательно: сайт письма не отправляет)
EMAIL_HOST=localhost
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_USE_TLS=0
